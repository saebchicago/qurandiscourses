{"68:35":[{"s":16,"a":17,"ar":"أَفَمَن يَخْلُقُ كَمَن لَّا يَخْلُقُ ۗ أَفَلَا تَذَكَّرُونَ","cat":"structural"}],"68:47":[{"s":52,"a":41,"ar":"أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ","cat":"structural"}],"68:7":[{"s":6,"a":117,"ar":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ مَن يَضِلُّ عَن سَبِيلِهِۦ ۖ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ","cat":"lexical"}],"68:13":[{"s":79,"a":30,"ar":"وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ","cat":"semantic"},{"s":68,"a":10,"ar":"وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ","cat":"structural"}],"68:10":[{"s":68,"a":13,"ar":"عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ","cat":"structural"},{"s":68,"a":11,"ar":"هَمَّازٍۢ مَّشَّآءٍۭ بِنَمِيمٍۢ","cat":"structural"},{"s":68,"a":12,"ar":"مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ","cat":"structural"}],"68:42":[{"s":17,"a":15,"ar":"مَّنِ ٱهْتَدَىٰ فَإِنَّمَا يَهْتَدِى لِنَفْسِهِۦ ۖ وَمَن ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيْهَا ۚ وَلَا تَزِرُ وَازِرَةٌۭ وِزْرَ أُخْرَىٰ ۗ وَمَا كُنَّا مُعَذِّبِينَ حَتَّىٰ نَبْعَثَ رَسُولًۭا","cat":"doctrinal"}],"68:30":[{"s":37,"a":50,"ar":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ","cat":"structural"}],"68:11":[{"s":68,"a":10,"ar":"وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ","cat":"structural"}],"68:12":[{"s":68,"a":10,"ar":"وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ","cat":"structural"}]}